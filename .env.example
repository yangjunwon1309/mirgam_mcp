# Docker-internal API URL used by the Next.js BFF.
API_URL=http://api:8000

# Any OpenAI-compatible Gemma inference server (vLLM, llama.cpp, etc.).
# The bundled Jetson launcher exposes llama.cpp on the Docker host gateway.
GEMMA_BASE_URL=http://host.docker.internal:8000/v1
GEMMA_MODEL=gemma-4-e2b
GEMMA_API_KEY=your-gemma-api-key
# Set this to define the dashboard's specialized role without changing code.
GEMMA_SYSTEM_PROMPT=You are MIRGAM, a concise smart-farm assistant. Answer in the user's language. Summarize only the provided sensor readings, image-analysis results, and KMA weather results; include key values and units, distinguish observations from forecasts, and do not invent missing data.
GEMMA_TEMPERATURE=0.3
# Keep this equal to GEMMA_CONTEXT_SIZE used when starting llama.cpp.
GEMMA_CONTEXT_SIZE=2048
GEMMA_MAX_OUTPUT_TOKENS=384
GEMMA_ENABLE_THINKING=false

# SQLite and image/analysis files live on the local SSD under storage/.
# In Compose this path is mounted from ./storage on the host.
SQLITE_PATH=/workspace/storage/state/mirgam.db

# The MCP service is deliberately separate from the API process.
MCP_URL=http://mcp:8765/mcp
MCP_MAX_TOOL_ROUNDS=3

# Beacon data is persisted outside the container; Compose starts the server.
BEACON_DATA_ROOT=/mnt/nvme/beacon
BEACON_POLL_INTERVAL_SECONDS=5

# Host-native model gateway; start scripts/serve-model-runner.sh separately.
MODEL_RUNNER_URL=http://host.docker.internal:8766

# Clearly-labelled local demo only: append a small noisy reading to the SQLite
# raw table at this interval. Disable this when a physical sensor ingester is
# connected.
DEMO_SIMULATOR_ENABLED=true
DEMO_SIMULATOR_INTERVAL_SECONDS=15
LOG_LEVEL=INFO

# Optional shared Mirgam account lookup. Set this only in the server-side .env;
# never add the SQLite Cloud URL to browser-facing or Next.js public variables.
# MIRGAM_DATABASE_URL=sqlitecloud://<host>:8860/<database>?apikey=<server-key>
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200

# KMA API Hub key in its original, unencoded form. Passed only to the MCP service.
KMA_API_KEY=

# VWorld calls are made by the FastAPI server; never expose these as NEXT_PUBLIC_*.
# Create a VWorld key with Geocoder, 2D Data, and WMTS/WMS (WMTS) enabled.
# VWORLD_KEY=
# The exact service URL registered to the VWorld key for 2D Data API calls.
# Include scheme, host, and port when registered; omit a page path, e.g. http://192.168.137.152:3100
# VWORLD_DOMAIN=http://your-registered-service-url
# DATA_ROOT=/workspace/storage
# CALC_CRS=EPSG:5186
# VWORLD_SAT_MIN_Z=13
# VWORLD_SAT_MAX_Z=19
# TILE_TTL_DAYS=180
# MAX_CROP_TILES=400
# MAX_CROP_PIXELS=30000000
