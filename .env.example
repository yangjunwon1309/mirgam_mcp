# Browser-facing API base path. The provided Web container uses this internal URL.
API_URL=http://api:8000

# Any OpenAI-compatible Gemma inference server (vLLM, llama.cpp, etc.).
# When Compose runs on macOS and the model server runs on the host, use host.docker.internal.
GEMMA_BASE_URL=http://host.docker.internal:8000/v1
GEMMA_MODEL=gemma-4
GEMMA_API_KEY=local

# SeaweedFS S3 endpoint. Containers use this internal endpoint.
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=gemma
S3_SECRET_KEY=change-me-before-sharing
S3_BUCKET=gemma-mcp
S3_REGION=us-east-1

# The MCP service is deliberately separate from the API process.
MCP_URL=http://mcp:8765/mcp
LOG_LEVEL=INFO

